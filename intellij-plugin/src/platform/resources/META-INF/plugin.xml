<idea-plugin>
    <id>io.btrace.drydock</id>
    <name>Drydock</name>
    <vendor>Jaroslav Bachorik</vendor>
    <description><![CDATA[
        Runs agent CLI sessions (Claude, Codex, pi) against git worktrees from
        inside the IDE: one window per worktree, the agent console as a pinned
        editor tab, and a durable session catalog that survives every window
        and restart.
    ]]></description>
    <depends>com.intellij.modules.platform</depends>
    <!-- TerminalExecutionConsole itself ships in the platform, but its
         rendering resolves the terminal plugin's colour scheme and font
         settings; the console renders wrong without it. -->
    <depends>org.jetbrains.plugins.terminal</depends>
    <depends>Git4Idea</depends>
    <!-- From 2026.3 VcsUtil, CurrentContentRevision, ShowDiffAction and the
         DVCS repository manager live in content modules of the bundled
         Version Control plugin. A plugin sees a content module's classes only
         through a module dependency; depending on Git4Idea is not enough, and
         the Plugin Verifier resolves the modules only with their plugin
         listed too. -->
    <dependencies>
        <plugin id="com.intellij.platform.vcs"/>
        <module name="intellij.platform.vcs"/>
        <module name="intellij.platform.vcs.impl"/>
        <module name="intellij.platform.vcs.impl.shared"/>
        <module name="intellij.platform.vcs.dvcs.impl"/>
    </dependencies>
    <!-- Optional: agents Drydock launches get the IDE's bundled MCP server,
         routed to their own worktree, when it is installed and running
         (app.drydock.intellij.mcp.IdeMcpServer). -->
    <depends optional="true" config-file="drydock-ide-mcp.xml">com.intellij.mcpServer</depends>
    <extensions defaultExtensionNs="com.intellij">
        <!-- A plain (not @State) application service: persistence goes through
             the core ApplicationStateStore single writer, so only the concrete
             class is registered (no separate service interface exists). -->
        <applicationService
                serviceImplementation="app.drydock.intellij.DrydockPluginService"/>

        <!-- Every agent process in the IDE and the window showing it, if any
             (cross-project tabs). The window's service below is a view of it. -->
        <applicationService
                serviceImplementation="app.drydock.intellij.agent.AgentExecutionRegistry"/>

        <!-- The window's view of the agents it shows, and the parent of its
             consoles. A declarative projectService (unlike the session
             service) because its only constructor argument is the project,
             and because the platform disposing it on project close is the
             backstop that stops whatever the window still shows. -->
        <projectService
                serviceImplementation="app.drydock.intellij.agent.AgentExecutionService"/>

        <!-- The agent console tab. The protocol exists so the IDE can restore
             a pinned console tab from the project's workspace file by URL; a
             LightVirtualFile has none, and drydock reopening tabs itself was
             the v2 duplicate-tab bug. -->
        <virtualFileSystem key="drydock-agent"
                           implementationClass="app.drydock.intellij.agent.AgentConsoleFileSystem"/>
        <fileEditorProvider
                implementation="app.drydock.intellij.agent.AgentConsoleEditorProvider"/>
        <!-- The tab's label and status-colored Drydock icon. The platform
             builds both from these extension points, not from
             FileEditor.getName(), so without them a console tab shows a bare
             session id. -->
        <editorTabTitleProvider
                implementation="app.drydock.intellij.agent.AgentConsoleTabPresentation"/>
        <fileIconProvider
                implementation="app.drydock.intellij.agent.AgentConsoleTabPresentation"/>

        <!-- ProjectRepositoryService and DrydockSessionService are plain
             classes with constructor arguments the component container
             cannot supply (the plugin's executor, the window's execution
             host), so instead of declarative projectService entries the
             startup activity constructs exactly one instance per project,
             holds them in the project's user data, and pre-warms the plugin
             init and the project's repository with visible progress. It
             starts no agent. -->
        <!-- "Stop n working agents?" before a window close or a quit stops
             agents mid-task. A close handler rather than an exit listener:
             the only exit veto (ApplicationListener.canExitApplication) is
             deprecated, and an exit closes every project through this. -->
        <projectCloseHandler
                implementation="app.drydock.intellij.agent.AgentCloseConfirmation"/>

        <!-- Settings > Tools > Drydock: the worktree base folder, shared with
             the standalone app through ~/.drydock/config.json. -->
        <applicationConfigurable parentId="tools" id="drydock" displayName="Drydock"
                                 instance="app.drydock.intellij.settings.DrydockConfigurable"/>

        <!-- The task-centric view: registered projects (shared with the
             standalone app) and their agent tasks, in every window. -->
        <toolWindow id="Drydock" anchor="right" secondary="false"
                    icon="/icons/drydock.svg"
                    factoryClass="app.drydock.intellij.tasks.DrydockToolWindowFactory"/>

        <!-- "Claude needs you": the balloon raised when an agent starts
             waiting for the user (AttentionNotifier). -->
        <notificationGroup id="Drydock attention" displayType="BALLOON"/>
        <!-- "<task> moved": a hosted agent's console went to its own window. -->
        <notificationGroup id="Drydock moves" displayType="BALLOON"/>
        <!-- "<task> is ready/review" and the plan halt/Continue balloons
             (TaskNotifications, T39a). -->
        <notificationGroup id="Drydock tasks" displayType="BALLOON"/>
        <!-- "Review posted on PR #n": the pull request lane's submit (W5e). -->
        <notificationGroup id="Drydock review" displayType="BALLOON"/>
        <!-- "PR #n merged/closed - done with <session>?": the session Done
             offer (PullRequestDoneOffers). -->
        <notificationGroup id="Drydock pull requests" displayType="BALLOON"/>

        <postStartupActivity
                implementation="app.drydock.intellij.startup.DrydockStartupActivity"/>

        <!-- The [[id]] / [[project:id]] navigation in task documents
             (T21a, P5): a caret inside a bracketed task reference in a
             store-root task document navigates to the referenced task's
             store file, resolved through the CACHED watched snapshot only
             (never a synchronous store scan) over plain bracket scanning
             in a bounded caret window - no Markdown dependency. Missing,
             ambiguous, broken and not-yet-published cases offer nothing. -->
        <gotoDeclarationHandler
                implementation="app.drydock.delayedtasks.TaskGotoDeclarationHandler"/>

        <!-- The Review surface (P3): Drydock's own review marks over the
             checkout's diff, as a dedicated tool window — the P2
             changesViewContent subtab was hard to discover and the
             operator rejected it. The window carries exactly one content
             (the ReviewTabProvider panel) and aligns itself with the first
             available Changes host (Commit, then Version Control) at
             registration from ReviewToolWindowFactory.init; the anchor
             below is only the first-layout default, because the stored
             layout overrides it from the first registration on. The
             factory follows the host's moves afterwards and ignores its
             own events; the separate "Drydock" task window above keeps
             its own right dock untouched. The factory applies Q8's
             ReviewTabVisibility coverage rule to availability, so a
             window with no covering session carries no empty Review
             window. Deliberately no <module> element for
             intellij.platform.diff / intellij.platform.diff.impl: they
             are internal-visibility product modules on 2026.3 and stay
             compile-only in build.gradle.kts, resolved at runtime through
             intellij.platform.vcs.impl. -->
        <!-- The review workbench (one reusable editor tab per project): the
             review's diff hosted next to its navigator, inbox and outbox. -->
        <fileEditorProvider
                implementation="app.drydock.intellij.review.ReviewWorkbenchEditorProvider"/>
        <!-- Task files live outside every project; Edit must open them writable. -->
        <nonProjectFileWritingAccessExtension
                implementation="app.drydock.intellij.delayedtasks.TaskFileWritingAccess"/>
        <!-- "Drydock: files in this review" in Find Usages / Find in Files. -->
        <searchScopesProvider implementation="app.drydock.intellij.review.ReviewSearchScopeProvider"/>

        <toolWindow id="Drydock Review" anchor="left" secondary="false"
                    icon="/icons/drydock.svg"
                    factoryClass="app.drydock.intellij.review.ReviewToolWindowFactory"/>

    </extensions>
    <applicationListeners>
        <!-- projectClosing, not the service's dispose: a disposing project's
             message bus no longer delivers the process-terminated event that
             carries the idle status, which left rows persisted as RUNNING with
             nothing running. -->
        <listener class="app.drydock.intellij.agent.AgentWindowCloseListener"
                  topic="com.intellij.openapi.project.ProjectManagerListener"/>
        <!-- Reopens the task windows remembered at the last quit when the IDE
             starts, and marks the start of a quit for AgentCloseConfirmation,
             so a quit asks once for every window. -->
        <listener class="app.drydock.intellij.agent.QuitSignal"
                  topic="com.intellij.ide.AppLifecycleListener"/>
        <!-- Every window's agents, so the "needs you" balloon can appear in
             whichever window the user is in. -->
        <listener class="app.drydock.intellij.agent.AttentionNotifier"
                  topic="app.drydock.intellij.agent.SessionActivityListener"/>
        <!-- A hosted agent's files, open as non-project files somewhere, are
             refreshed when its turn ends: no window watches its worktree. -->
        <listener class="app.drydock.intellij.agent.HostedFileRefresher"
                  topic="app.drydock.intellij.agent.SessionActivityListener"/>
    </applicationListeners>
    <actions>
        <!-- The review diff's selection actions (ReviewSelectionAction): the
             composer in the workbench inbox, for the selected lines. -->
        <action id="Drydock.Review.CommentOnSelection"
                class="app.drydock.intellij.review.ReviewSelectionAction$Comment"
                text="Comment on Selection"
                description="Add a review comment on the selected lines of the diff">
            <add-to-group group-id="Diff.EditorPopupMenu" anchor="first"/>
        </action>
        <action id="Drydock.Review.AskAboutSelection"
                class="app.drydock.intellij.review.ReviewSelectionAction$Ask"
                text="Ask Reviewer About Selection…"
                description="Ask the review's agent about the selected lines; the answer arrives as a finding">
            <add-to-group group-id="Diff.EditorPopupMenu" anchor="after"
                          relative-to-action="Drydock.Review.CommentOnSelection"/>
        </action>
        <!-- Drydock is reached through its tool window, not a menu: New
             Session is outside it so the shortcut works anywhere, and the
             from-branch entry so Git's branch menus can start one. The
             New Session label is the D5 rename; the action ids, classes
             and shortcuts never changed. -->
        <action id="Drydock.NewTask"
                class="app.drydock.intellij.tasks.NewTaskAction"
                text="New Session…"
                description="Start an agent session"
                icon="AllIcons.General.Add">
            <!-- $default "alt meta N" is ⌃⌥N on macOS (the keymaps swap meta
                 and control). Not ⌥⌘N: on macOS that is Refactor | Inline in
                 an editor and Git's New Branch elsewhere. -->
            <keyboard-shortcut keymap="$default" first-keystroke="alt meta N"/>
        </action>
        <!-- Git's per-branch menu: the Log's Branches pane and the branches
             popup both build it from Git.Branch. Its label keeps the
             task wording (D5 renames the session action's label, not this
             class's text, which its own update() sets). -->
        <action id="Drydock.NewTaskFromBranch"
                class="app.drydock.intellij.tasks.NewTaskFromBranchAction"
                text="New Drydock Task from Branch…"
                description="Start an agent on a new task from this branch">
            <add-to-group group-id="Git.Branch" anchor="first"/>
        </action>
        <!-- The delayed-task layer's tree actions (T20a): the Drydock tree's
             task-node context menu. Status writes ride the task service's
             actor-aware seam (an agent may never drop, T07), Go to blocker
             session resolves over the watched snapshot, and Drop is asked
             first. No shortcuts: the tree is their only surface; the panel
             looks the ids up and falls back to locally built instances. -->
        <action id="Drydock.DelayedTask.Start"
                class="app.drydock.intellij.delayedtasks.DelayedTaskActions$Start"
                text="Start Session…"
                description="Start one session for this task and its same-project plan"/>
        <action id="Drydock.DelayedTask.Claim"
                class="app.drydock.intellij.delayedtasks.DelayedTaskActions$Claim"
                text="Claim Stacked Session…"
                description="Launch this follow-up as its own session, stacked on its prerequisite's dd/&lt;id&gt; branch"/>
        <action id="Drydock.DelayedTask.Cancel"
                class="app.drydock.intellij.delayedtasks.DelayedTaskActions$Cancel"
                text="Cancel Plan"
                description="Cancel this task's plan: future stages never start, started sessions keep running, unlaunched reservations are released"/>
        <action id="Drydock.DelayedTask.Edit"
                class="app.drydock.intellij.delayedtasks.DelayedTaskActions$Edit"
                text="Edit"
                description="Open the task's file in the editor"/>
        <action id="Drydock.DelayedTask.Drop"
                class="app.drydock.intellij.delayedtasks.DelayedTaskActions$Drop"
                text="Drop…"
                description="Drop this task; a dropped task is done for and only a human may drop it"/>
        <action id="Drydock.DelayedTask.Confirm"
                class="app.drydock.intellij.delayedtasks.DelayedTaskActions$Confirm"
                text="Confirm Done"
                description="Accept the agent's done; the plan continues"/>
        <action id="Drydock.DelayedTask.Reopen"
                class="app.drydock.intellij.delayedtasks.DelayedTaskActions$Reopen"
                text="Reopen"
                description="Set the task back to open"/>
        <action id="Drydock.DelayedTask.GotoBlockerSession"
                class="app.drydock.intellij.delayedtasks.DelayedTaskActions$GotoBlockerSession"
                text="Go to Blocker Session"
                description="Switch to the session that runs this task's blocker"/>
        <!-- Mirroring a task into a GitHub issue or a Jira ticket: the task
             stays, records the mirror's address, and the mirror names the
             task and carries its metadata in hidden form. -->
        <action id="Drydock.DelayedTask.MirrorToGitHub"
                class="app.drydock.intellij.delayedtasks.DelayedTaskActions$MirrorToGitHub"
                text="Mirror to GitHub Issue…"
                description="Create a GitHub issue from this task and link the two; the task stays"/>
        <action id="Drydock.DelayedTask.MirrorToJira"
                class="app.drydock.intellij.delayedtasks.DelayedTaskActions$MirrorToJira"
                text="Mirror to Jira…"
                description="Create a Jira ticket from this task and link the two; the task stays"/>
        <action id="Drydock.DelayedTask.OpenMirrors"
                class="app.drydock.intellij.delayedtasks.DelayedTaskActions$OpenMirrors"
                text="Open Mirrored Issue"
                description="Open the GitHub issue or Jira ticket this task is mirrored into"/>
        <action id="Drydock.DelayedTask.Refresh"
                class="app.drydock.intellij.delayedtasks.DelayedTaskActions$Refresh"
                text="Refresh"
                description="Re-read the task store now; a task file modified but unsaved in an editor refuses the reload"/>
        <!-- The agent console tab's own commands (A7): the header shortcuts
             ride EditorTabActionGroup, the platform's per-tab label-action
             seam, so every agent console tab carries them and a click
             targets THAT tab's session, never the selected editor's.
             Visibility constraint: agent console tabs are PINNED BY
             DEFAULT, and on a pinned tab the header icons are painted
             unconditionally. Consequence: if the user unpins a tab, the
             IDE's native New UI paint gate applies — the icons are painted
             only while that unpinned tab is selected, hovered, or otherwise
             qualifies for the gate (e.g. modified), exactly like stock
             tab-label actions. Drydock deliberately does not work around
             that gate: no re-pinning, no internal hover-state sampling, no
             global tab-presentation change (user-approved native behavior);
             the console's full labeled ribbon remains the always-available
             surface. The popup-only commands are registered here for the
             tab popup contribution to reference. update() sets every label;
             the XML texts are the accessible fallbacks. Stock close, pin
             and split are untouched. -->
        <action id="Drydock.AgentTab.OwnProject"
                class="app.drydock.intellij.agent.AgentTabActions$OwnProject"
                text="Project window"/>
        <action id="Drydock.AgentTab.Changes"
                class="app.drydock.intellij.agent.AgentTabActions$Changes"
                text="Changes"/>
        <action id="Drydock.AgentTab.Lifecycle"
                class="app.drydock.intellij.agent.AgentTabActions$Lifecycle"
                text="Lifecycle"/>
        <action id="Drydock.AgentTab.Transfer"
                class="app.drydock.intellij.agent.AgentTabActions$Transfer"
                text="Transfer…"/>
        <action id="Drydock.AgentTab.Rename"
                class="app.drydock.intellij.agent.AgentTabActions$Rename"
                text="Rename…"/>
        <action id="Drydock.AgentTab.Done"
                class="app.drydock.intellij.agent.AgentTabActions$Done"
                text="Done…"/>
        <!-- The tab-header shortcut group: own-project window, the lifecycle
             and Done — the compact supplement to the ribbon's full labels
             (A7). anchor="first" keeps it ahead of the stock actions the
             platform adds to the same group. -->
        <group id="Drydock.AgentTabShortcuts">
            <reference ref="Drydock.AgentTab.OwnProject"/>
            <reference ref="Drydock.AgentTab.Lifecycle"/>
            <reference ref="Drydock.AgentTab.Done"/>
            <add-to-group group-id="EditorTabActionGroup" anchor="first"/>
        </group>
        <!-- The tab popup's Drydock block (T15, A10): one dynamic group
             added to the platform's stock EditorTabPopupMenu, anchor first,
             so a right-click on an agent console tab leads with its own
             commands before the stock close/pin/split entries — which are
             untouched. The group carries no children of its own in XML: it
             builds them per right-click from the registered actions above,
             in sections with separators, and contributes nothing at all on
             a non-agent tab (getChildren returns EMPTY_ARRAY), so ordinary
             tabs keep the stock popup unchanged. -->
        <group id="Drydock.AgentTabPopup"
               class="app.drydock.intellij.agent.AgentTabPopupGroup"
               popup="false">
            <add-to-group group-id="EditorTabPopupMenu" anchor="first"/>
        </group>
    </actions>
</idea-plugin>
